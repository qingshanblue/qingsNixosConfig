# 主用户账户 qings 的配置：权限组、Shell 环境、提示符与全局开发变量。

{ config, pkgs, ... }:

{
  users.users."qings" = {
    isNormalUser = true;
    description = "qingshanblue";
    extraGroups = [
      "networkmanager"
      "wheel"
      "seat"
      "tty"
      "input"
      "podman"
      "wireshark"
      "dialout"
      "plugdev"
    ];
    shell = pkgs.zsh;
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICqmCl4hD4e1vYIa7yCE30jpCSutMYJgEF6fiw8s26l6 qingshanblue@gmail.com"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKBTik+UnY/ZAwXUBrQe903WrXWirnP3E52j7J1z2sxD Generated By Termius"
    ];
  };

  # ---------- Shell 与命令行环境 ----------
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestions.enable = true;
    syntaxHighlighting.enable = true;
    # 把 nix-ld 聚合的库路径交给 LD_LIBRARY_PATH（交互式 shell 启动时生效）
    interactiveShellInit = ''
      export LD_LIBRARY_PATH="''${NIX_LD_LIBRARY_PATH}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    '';
  };
  programs.starship.enable = true;

  # ---------- 环境管理与变量 ----------
  programs.direnv.enable = true;
  environment.sessionVariables = {
    LIBVA_DRIVER_NAME = "nvidia";
    NIXOS_OZONE_WL = "1";
    ELECTRON_OZONE_PLATFORM_HINT = "auto";
    NVD_BACKEND = "direct";          # 新驱动（525+）必须用 direct 后端
    MOZ_DISABLE_RDD_SANDBOX = "1";   # 只有用 Firefox 才需要
  };
  environment.variables = {
    EDITOR = "nvim";
  };
}
