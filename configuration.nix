{ config, pkgs, ... }:

let
  # ---------- XWayland 缩放包装器 ----------
  mkScaled = name: pkg: bin: wrapperArgs:
    pkgs.symlinkJoin {
      inherit name;
      paths = [ pkg ];
      nativeBuildInputs = [ pkgs.makeWrapper ];
      postBuild = "wrapProgram $out/bin/${bin} ${wrapperArgs}";
    };
in
{
  imports = [
    ./hardware-configuration.nix
    ./astrbot.nix
  ];

  # ---------- Bootloader ----------
  boot.loader = {
    systemd-boot.enable = false;
    grub = {
      enable = true;
      device = "nodev";
      efiSupport = true;
      useOSProber = true;
      theme = pkgs.catppuccin-grub.override {
        flavor = "mocha";
      };
    };
    efi.canTouchEfiVariables = true;
  };

  # tuxedo-drivers 4.20.1 的 Makefile 把 $(MAKEFLAGS) 展开进 recipe；新版 nixpkgs 的
  # kernelModuleMakeFlags 含 cmd_sign=...$(space)$@（MAKEFLAGS 中转义成 $$(space)），
  # bash 会当 $$(PID)+( 而报语法错误。让子 make 从环境继承变量即可（保留 kmodigest 签名，
  # 签名证书是 nixpkgs 组装 linux-modules 必需的）。--replace-fail 保证上游改了就报错。
  # TODO: nixpkgs 修复 cmd_sign/MAKEFLAGS 互操作后删掉这段。
  boot.kernelPackages = pkgs.linuxPackages.extend (final: prev: {
    tuxedo-drivers = prev.tuxedo-drivers.overrideAttrs (old: {
      postPatch = (old.postPatch or "") + ''
        substituteInPlace Makefile --replace-fail ' $(MAKEFLAGS)' ""
      '';
    });
  });
  boot.kernelParams = [ "resume=UUID=32a6a3c5-1ece-42cf-b802-9cb043a56e21" ];
  boot.kernelModules = ["usbmon"];

  # ---------- 内核参数 ----------
  networking.hostName = "nixos";
  networking.networkmanager.enable = true;

  # getaddrinfo IPv4 优先（RFC 6724 排序覆盖）
  networking.getaddrinfo.precedence = {
    "::ffff:0:0/96" = 100;
  };

  time.timeZone = "Asia/Taipei";
  networking.timeServers = [                                                       
    "ntp.aliyun.com"                                                               
    "ntp1.aliyun.com"                                                              
    "ntp2.aliyun.com"                                                              
    "time1.cloud.tencent.com"                                                      
  ];

  # ---------- 国际化与 Locale ----------
  i18n.defaultLocale = "zh_TW.UTF-8";
  i18n.supportedLocales = [
    "zh_TW.UTF-8/UTF-8"
    "en_US.UTF-8/UTF-8"
  ];

  i18n.extraLocaleSettings = {
    LC_ADDRESS = "zh_TW.UTF-8";
    LC_IDENTIFICATION = "zh_TW.UTF-8";
    LC_MEASUREMENT = "zh_TW.UTF-8";
    LC_MONETARY = "zh_TW.UTF-8";
    LC_NAME = "zh_TW.UTF-8";
    LC_NUMERIC = "zh_TW.UTF-8";
    LC_PAPER = "zh_TW.UTF-8";
    LC_TELEPHONE = "zh_TW.UTF-8";
    LC_TIME = "zh_TW.UTF-8";
  };

  # ---------- 输入法配置 ----------
  i18n.inputMethod = {
    enable = true;
    type = "fcitx5";
    fcitx5 = {
      waylandFrontend = true;
      addons = with pkgs; [
        (fcitx5-rime.override { rimeDataPkgs = [ rime-ice ]; })
        fcitx5-gtk
      ];
    };
  };

  # ---------- 字体配置 ----------
  fonts.packages = with pkgs; [
    maple-mono.NF-CN-unhinted
    noto-fonts
    noto-fonts-cjk-sans
    noto-fonts-cjk-serif
    noto-fonts-color-emoji
    dejavu_fonts
    liberation_ttf
    wqy_microhei
    wqy_zenhei
  ];

  fonts.fontconfig.defaultFonts = {
    monospace = [ "MapleMono NF CN" "Noto Sans Mono CJK SC" ];
    sansSerif = [ "Noto Sans CJK SC" "Noto Sans" ];
    serif    = [ "Noto Serif CJK SC" "Noto Serif" ];
    emoji    = [ "Noto Color Emoji" ];
  };

  # ---------- /usr/share/fonts 兼容层 ----------
  systemd.tmpfiles.rules = [
    # --- DejaVu（Unity Linux fallback 硬编码路径，本条直接修复 Mortuus）---
    "L+ /usr/share/fonts/truetype/dejavu - - - - ${pkgs.dejavu_fonts}/share/fonts/truetype"

    # --- Noto CJK（Debian/Arch 的 noto 布局）---
    "L+ /usr/share/fonts/opentype/noto - - - - ${pkgs.noto-fonts-cjk-sans}/share/fonts/opentype/noto-cjk"

    # --- WenQuanYi（老程序 / Wine 常见探测点）---
    "L+ /usr/share/fonts/truetype/wqy - - - - ${pkgs.wqy_microhei}/share/fonts/truetype"

    # --- 其余常见目录，覆盖按目录扫描的程序 ---
    "L+ /usr/share/fonts/truetype/noto - - - - ${pkgs.noto-fonts}/share/fonts/truetype"
    "L+ /usr/share/fonts/truetype/liberation - - - - ${pkgs.liberation_ttf}/share/fonts/truetype"
  ];

  # ---------- 用户账户 ----------
  users.users."qings" = {
    isNormalUser = true;
    description = "qingshanblue";
    extraGroups = [ "networkmanager" "wheel" "seat" "tty" "input" "podman" "wireshark" "dialout" "plugdev"];
    shell = pkgs.zsh;
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICqmCl4hD4e1vYIa7yCE30jpCSutMYJgEF6fiw8s26l6 qingshanblue@gmail.com"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKBTik+UnY/ZAwXUBrQe903WrXWirnP3E52j7J1z2sxD Generated By Termius"
    ];
  };
  services.udev = {
    packages = [ pkgs.libsigrok pkgs.openocd ];
    extraRules = ''
      SUBSYSTEM=="usb", ATTR{idVendor}=="faed", ATTR{idProduct}=="4870", MODE="0666", TAG+="uaccess"
      SUBSYSTEM=="hidraw", ATTRS{idVendor}=="faed", ATTRS{idProduct}=="4870", MODE="0666", TAG+="uaccess"
      SUBSYSTEM=="usbmon", GROUP="wireshark", MODE="0640"
    '';
  };
  # ---------- 垃圾回收与存储优化 ----------
  nix.optimise.automatic = true;
  nix.gc = {
    automatic = true;
    dates = "daily";
    options = "";
  };
  # 每次自动回收前只保留最近 5 代系统代数（"-" 前缀：失败不阻断 GC）
  systemd.services.nix-gc.serviceConfig.ExecStartPre = [
    "-${pkgs.nix}/bin/nix-env -p /nix/var/nix/profiles/system --delete-generations +5"
  ];

  # 系统服务环境变量 
  systemd.globalEnvironment = {
     http_proxy  = "http://127.0.0.1:20122";
     https_proxy = "http://127.0.0.1:20122";
     all_proxy   = "socks5://127.0.0.1:20122";
     no_proxy    = "localhost,127.0.0.1,::1";
  };
  
  # ---------- 系统软件包 ----------
  environment.systemPackages = with pkgs; [
    # Waydroid ARM 转译层安装工具
    (stdenv.mkDerivation {
      pname = "waydroid-script";
      version = "2026-01-05";
      src = fetchzip {
        url = "https://github.com/casualsnek/waydroid_script/archive/d5289cfd8929e86e7f0dc89ecadcef8b66930eec.tar.gz";
        sha256 = "sha256-zSHZlhHJHWZRE3I5pYWhD4o8aNpa8rTiEtl2qJTuRjw=";
      };
      nativeBuildInputs = [ makeWrapper ];
      installPhase = ''
        mkdir -p $out/share/waydroid-script $out/bin
        cp -r . $out/share/waydroid-script/
        makeWrapper ${lib.getExe (python3.withPackages (p: with p; [ requests tqdm inquirerpy ]))} \
          $out/bin/waydroid-script \
          --add-flags "$out/share/waydroid-script/main.py"
      '';
    })
    
    # Development
    git github-desktop yq android-tools nodejs typescript bun typescript-language-server
    clang clang-tools lldb cmake ninja gnumake bintools
    python3 pixi uv
    rustc cargo rust-analyzer clippy rustfmt
    go gopls delve golangci-lint
    bubblewrap socat ripgrep
    termius
    
    # System & Desktop
    dig mtr glib wget xdg-user-dirs busybox neovim kitty nemo
    wl-clipboard hardinfo2 playerctl
    elephant walker libnotify brightnessctl ddcutil
    dotnet-runtime
    kdePackages.ark hyprpolkitagent hyprpaper hyprshot hyprpicker hyprlock
    hypridle hyprshutdown hyprsunset hyprsysteminfo hyprland-qt-support
    fastfetch qt6Packages.fcitx5-configtool mission-center
    adwaita-icon-theme papirus-icon-theme 
    pavucontrol blueman bluez-tools google-chrome firefox
    vscode.fhs celluloid swayimg steam-run
    ouch fd iptables ncdu smartmontools podman-compose kubectl
    
    # User Apps
    openlist
    (gui-for-singbox.overrideAttrs (old: {
      nativeBuildInputs = (old.nativeBuildInputs or []) ++ [ makeWrapper ];
      postInstall = (old.postInstall or "") + ''
        wrapProgram $out/bin/GUI.for.SingBox \
          --set __NV_DISABLE_EXPLICIT_SYNC 1
      '';
    }))
    #YesPlayMusic
    scrcpy go-musicfox 
    qq telegram-desktop
    wechat
    wpsoffice-cn libreoffice podman-desktop gparted
    obsidian /* zotero */ kdePackages.okular
    ## 修复 HTTPS 下载报 "unable to get local issuer certificate (20)"：
    # rayburst 捆绑的预编译引擎 aria2-next（上游 Ubuntu CI 编译）把 CA 证书库，
    # 路径硬编码为 FHS 路径，NixOS 上不存在，导致 TLS 验证失败。
    # 应用侧无解：Rayburst 每次启动重写 engine/aria2.conf，且其 aria2 选项
    # 白名单（src/shared/aria2Options.json）不含 ca-certificate。
    # 故用 wrapper 给引擎追加命令行参数（命令行优先级高于 conf，免疫重写）。
    # 待 nixpkgs/rayburst 上游修复后可整体删除本 override。
    (rayburst.overrideAttrs (old: {
      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ makeWrapper ];
      postFixup = (old.postFixup or "") + ''
        wrapProgram $out/bin/aria2-next \
          --add-flags "--ca-certificate=/etc/ssl/certs/ca-certificates.crt"
      '';
    }))

    # Engineering
    openocd stm32flash gcc-arm-embedded
    # KiCad 10 的“选择工程模板”对话框用 wxWebView(WebKitGTK) 渲染模板预览。
    # WebKit 的 DMA-BUF 渲染器会为该 toplevel 的 wl_surface 启用 linux-drm-syncobj
    # 显式同步，而 GTK3 随后用共享内存 wl_buffer 提交同一 surface 却没带 acquire
    # timeline；Hyprland 按协议报 no_acquire_point 并断开客户端，GDK3 收到断连后
    # 静默 _exit(1) —— 表现为“点任意模板后 KiCad 瞬间消失”（无 stderr、无 core）。
    # 规避：让 webview 退回软件渲染，预览仍然正常显示。
    # 待 WebKitGTK / GTK3 / NVIDIA egl-wayland 上游修复后，删除本 override、
    # 直接写回 `kicad` 即可。
    (kicad.overrideAttrs (old: {
      nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ makeWrapper ];
      postInstall = (old.postInstall or "") + ''
        for prog in kicad pcbnew eeschema gerbview pcb_calculator pl_editor; do
          wrapProgram "$out/bin/$prog" --set WEBKIT_DISABLE_DMABUF_RENDERER 1
        done
      '';
    }))
    # STM32CubeMX 是 Swing/AWT（XWayland）。Java2D 的 sun.java2d.uiScale 只支持整数，
    # 实测 1.6/1.5 都被截断成 1。只能在 1（太小）和 2（比 1.6 大 25%，但清晰）之间选 2；
    # 只作用于 CubeMX（以前是全局 _JAVA_OPTIONS，会顺带影响所有 JVM）。
    (mkScaled "stm32cubemx-scaled" stm32cubemx "stm32cubemx"
      ''--set _JAVA_OPTIONS "-Dsun.java2d.uiScale=2"'')
    ngspice simulide #bambu-studio
    freecad openscad # build123d 
    pulseview sigrok-cli sigrok-firmware-fx2lafw 
    
    # Games
    protonup-rs bottles olympus osu-lazer prismlauncher
    # HMC L 是 JavaFX（XWayland）。JavaFX 支持分数缩放：HMCL 会把 HMCL_UI_SCALE
    # 转成 glass.gtk.uiScale。实测 1.6 真的生效（日志 Screen 1: 2560x1440 @1.6x，
    # 逻辑 1600x900），字与控件都清晰。也接受 160% / 154dpi 写法。
    (mkScaled "hmcl-scaled" hmcl "hmcl" "--set HMCL_UI_SCALE 1.6")
    
    # Agents
    cc-switch codex claude-code pi-coding-agent
  ];

  # ---------- Nix-ld (用于运行预编译二进制) ----------
  programs.nix-ld = {
    enable = true;
    libraries = with pkgs; [
      zlib zstd stdenv.cc.cc.lib glib libGL libxkbcommon fontconfig libxshmfence freetype wayland libxcb-cursor libxcb-image libxcb-keysyms libxcb-render-util libxcb-wm libx11 libxext libxi libxrender fuse3 libxrandr libxcursor libxcomposite libxdamage libxfixes libxcb dbus  webkitgtk_4_1 gtk3 glib-networking gdk-pixbuf cairo pango libsoup_3
    ];
  };

  # ---------- 定时任务 ----------
  services.cron = {
    enable = true;
    systemCronJobs = [
      "00 01 * * * root /run/current-system/sw/bin/shutdown -h +3 \"System auto shutdown in 3 minutes...\""
    ];
  };

  # ---------- Shell 与提示符 ----------
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestions.enable = true;
    syntaxHighlighting.enable = true;
    
  };
  programs.starship.enable = true;

  # ---------- Flatpak 与 Portal ----------
  services.flatpak.enable = true;
  xdg.portal = {
    enable = true;
    extraPortals = [
      pkgs.xdg-desktop-portal-gtk
      pkgs.xdg-desktop-portal-hyprland
    ];
  };

  programs.appimage = {
  enable = true;
  binfmt = true;
  # 使用 override 添加额外的依赖包
  package = pkgs.appimage-run.override {
    extraPkgs = pkgs: with pkgs; [
      libepoxy libgpg-error
      # 可以继续添加其他缺失的库，如 python312 等
    ];
  };
};

  # ---------- Podman 容器虚拟化 ----------
  environment.etc."containers/registries.conf".text = ''
    unqualified-search-registries = ["docker.io"]
  '';
  virtualisation.podman = {
    enable = true;
    dockerCompat = true;
    defaultNetwork.settings.dns_enabled = true;
  };

  # ---------- 桌面环境 ----------
  # services.desktopManager.plasma6.enable = true;
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;
    withUWSM = true;
  };

  # ---------- Sunshine  ----------
  services.sunshine = {
    enable = true;
    autoStart = false;
    capSysAdmin = false;
    openFirewall = true;
    settings.port = 47989;
  };

  programs.wireshark = {  
    enable = true;
    package = pkgs.wireshark;
    dumpcap.enable = true;
    usbmon.enable = true;
  };

  # ---------- Steam ----------
  programs.steam = {
    enable = true;
    package = pkgs.steam.override { extraEnv = { GDK_SCALE = "2"; }; };
    remotePlay.openFirewall = true;
    dedicatedServer.openFirewall = true;
  };

  # ---------- 开发工具 ----------
  programs.direnv.enable = true;

  # ---------- 登录管理器 ----------
  services.displayManager = {
    sddm = {
      enable = true;
      wayland.enable = true;
    };
    defaultSession = "hyprland-uwsm";
    autoLogin = {
      enable = true;
      user = "qings";
    };
  };

  programs.dux-shell = {
    enable = true;
    systemd = {
      enable = true;             # Systemd service for auto-start
      restartIfChanged = true;   # Auto-restart dms.service when dms-shell changes
    };
  };

  # ---------- 系统服务 ----------
  security.polkit.enable = true;
  services.gvfs.enable = true;
  services.udisks2.enable = true;
  services.upower.enable = true;          
  services.elephant.enable = true;
  services.power-profiles-daemon.enable = true; 
  systemd.user.services.elephant.environment.PATH = pkgs.lib.mkForce "/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/qings/bin:/home/qings/.nix-profile/bin:/home/qings/.local/share/flatpak/exports/bin:/var/lib/flatpak/exports/bin:${pkgs.bash}/bin";


  # ---------- 音频 ----------
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
  };

  # ==============================================================
  # ---------- 图形与 NVIDIA 驱动 (最小化基准配置) ----------
  # ==============================================================
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };
  
  nixpkgs.config.nvidia.acceptLicense = true;
  services.xserver.videoDrivers = [ "nvidia" ];
  hardware.nvidia = {
    open = true;                    # Ampere 官方主线，电源管理/挂起恢复修复都在这条线
    modesetting.enable = true;
    nvidiaSettings = true;
    powerManagement.enable = true;  # 休眠唤醒需要
    gsp.enable = true;              # open 模块必需 GSP 固件；stock 包自带，勿回退到手动 pin
    package = config.boot.kernelPackages.nvidiaPackages.stable;  # 锁定渠道内 = 595.104.02
  };
  # ==============================================================

  # ---------- Waydroid ----------
  virtualisation.waydroid = {
    enable = true;
    package = pkgs.waydroid-nftables;
  };

  # ---------- 网络与蓝牙 ----------
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
  };

  services.avahi = {
    enable = true;
    settings.publish = {
      "disable-publishing" = false;
      "disable-user-service-publishing" = false;
      "publish-addresses" = true;
    };
  };

  hardware.tuxedo-rs = {
    enable = true;
    tailor-gui.enable = true;
  };

  # ---------- 风扇控制：休眠恢复后重建 Uniwill EC 手动控制 ----------
  # S4 恢复会丢两份状态：tuxedo_io 的 fans_initialized 与 EC 0x0741 手动使能位
  # （uniwill_wmi probe 时写入）。需重载两模块并强制写一次转速，见 tuxedo-rs #180。
  systemd.services.tuxedo-fan-resume = {
    description = "Restore Uniwill EC fan control after sleep";
    after = [ "suspend.target" "hibernate.target" "hybrid-sleep.target" ];
    wantedBy = [ "suspend.target" "hibernate.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = let
        script = pkgs.writeShellScript "tuxedo-fan-resume" ''
          # SIGKILL 直接杀：优雅 stop 会触发 tailord 自身 SIGABRT + coredump，白耗 ~2s
          /run/current-system/sw/bin/systemctl kill -s SIGKILL tailord.service 2>/dev/null || true
          /run/current-system/sw/bin/systemctl stop tailord.service 2>/dev/null || true
          /run/current-system/sw/bin/modprobe -r tuxedo_io uniwill_wmi || true
          /run/current-system/sw/bin/modprobe uniwill_wmi
          /run/current-system/sw/bin/modprobe tuxedo_io
          /run/current-system/sw/bin/systemctl start tailord.service
          # 不再盲等 3s：轮询等待 tailord 的 DBus 方法可服务（实测首次调用会阻塞到 fan 初始化完成）
          # 每次调用限 2s 超时，成功即退；最多等 30s，超时则失败以便 systemd 标记
          for i in $(seq 1 60); do
            if /run/current-system/sw/bin/busctl call --timeout=2s com.tux.Tailor /com/tux/Tailor com.tux.Tailor.Fan OverrideSpeed yy 0 30 2>/dev/null \
               && /run/current-system/sw/bin/busctl call --timeout=2s com.tux.Tailor /com/tux/Tailor com.tux.Tailor.Fan OverrideSpeed yy 1 30 2>/dev/null; then
              exit 0
            fi
            /run/current-system/sw/bin/sleep 0.5
          done
          echo "tuxedo-fan-resume: tailord DBus not ready after 30s" >&2
          exit 1
        '';
      in [ "${script}" ];
    };
  };

  # ==============================================================
  # ---------- 环境变量 (清理为最小化) ----------
  # ==============================================================
  environment.sessionVariables = {
    NIXOS_OZONE_WL = "1";
    ELECTRON_OZONE_PLATFORM_HINT = "auto";
  };
  environment.variables = {
    EDITOR = "nvim";
  };
  # ==============================================================

  # ---------- 合盖行为 ----------
  services.logind.settings = {
    Login = {
      IdleAction = "lock";
      IdleActionUSec = "10min";
      HandleLidSwitch = "ignore";
      HandleLidSwitchExternalPower = "ignore";
      HandleLidSwitchDocked = "ignore";
    };
  };

  # ---------- SSH 服务 ----------
  services.openssh = {
    enable = true;
    ports = [ 2222 ];
    settings = {
      PasswordAuthentication = false;
      PermitRootLogin = "no";
      PubkeyAuthentication = true;
    };
  };

  # ---------- WEBUI for SingBox ----------
  systemd.services.webui-for-singbox = {
    after = [ "network-online.target" ];
    wants = [ "network-online.target" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      User = "qings";
      ExecStart = "/home/qings/.local/share/webui-for-singbox/webui.for.singbox";
      WorkingDirectory = "/home/qings";
      Restart = "on-failure";
      RestartSec = 3;
      AmbientCapabilities = [ "CAP_NET_ADMIN" "CAP_NET_RAW" ];
      CapabilityBoundingSet = [ "CAP_NET_ADMIN" "CAP_NET_RAW" ];
    };
  };


  programs.proxychains = {
    enable = true;
    proxies = {
      localProxy = {
        type = "socks5";
        host = "localhost";
        port = "20122";
      };
    };
  };

  # ---------- Tailscale 组网 ----------
  services.tailscale = {
    enable = true;
    openFirewall = true;  # 放行 UDP 41641，提高打洞直连成功率
  };

  # ---------- 防火墙 ----------
  networking.firewall = {
    enable = true;
    allowedTCPPorts = [ 2222 20122 ];
    allowedUDPPorts = [ 20122 ];
  };

  nixpkgs.config.allowUnfree = true;

  # ---------- Nix 设置与镜像源 ----------
  nix.settings = {
    substituters = [
      "https://mirrors.cernet.edu.cn/nix-channels/store"
      "https://cache.nixos.org"
